{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Burrow",
  "version": "0.1.0",
  "identifier": "io.github.trollord.burrow",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Burrow",
        "width": 760,
        "height": 860,
        "minWidth": 560,
        "minHeight": 520,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
